{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "google-docs": {
        "enabled": true,
        "type": "local",
        "command": ["npx", "-y", "@a-bonus/google-docs-mcp"],
        "environment": {
          "GOOGLE_CLIENT_ID": "{env:GOOGLE_API_CLIENT_ID}",
          "GOOGLE_CLIENT_SECRET": "{env:GOOGLE_API_CLIENT_SECRET}"
        }
      }
    }
  }
}
